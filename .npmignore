# .npmignore for dsh-desktop
# This project is published as Tauri installers via GitHub/Gitee Releases (see .github/workflows/release.yml),
# NOT as an npm package. This file exists defensively in case the repo is ever consumed via `npm install`,
# `pnpm install`, or similar (e.g. as a local dependency / git dep). It mirrors `.gitignore` and excludes
# anything that isn't source code or documentation.

# ----- Build / target artifacts -----
/target
**/target
/src-tauri/target
/src-tauri/gen/
/src-tauri/binaries/

# ----- Runtime vendor (generated by `just vendor`) -----
/vendor/dsh-runtime/
/vendor/node-runtime/
/vendor/webview2/

# ----- Screenshots / large binary assets (kept in git for README, but excluded from npm tarball) -----
# repo carries these so GitHub/Gitee README renders; npm tarball must stay small.
/assets/screen/

# ----- Signing / secrets -----
/.tauri/
*.key
*.sig

# ----- IDE / editor / OS junk -----
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# ----- Internal ZCode / vision-router / reasonix caches -----
.zcode/
.dsh-vision-router/
.reasonix/
.npm-cache/
videos/
assets/repos/

# ----- Node -----
node_modules/

# ----- CI -----
.github/

# ----- Docs / scripts (keep source docs, exclude transient logs) -----
plugin-add.log