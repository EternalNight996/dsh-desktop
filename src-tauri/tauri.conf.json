{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-desktop",
  "version": "0.8.1",
  "identifier": "com.eternalnight.dshdesktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "url": "index.html"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1QzQwRTcwRDdFN0RBRUIKUldUcjJ1ZlhjQTdFdFJVVk1wOW9MK0pXMnY1Mkx5TmJ5MGZ4Nk1ZZlBBNkxvNlNlTU5QR2FaMk0K",
      "endpoints": [
        "https://github.com/EternalNight996/dsh-desktop/releases/latest/download/latest.json",
        "https://gitee.com/eternalnight996/dsh-desktop/raw/gitee/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    },
    "externalBin": ["binaries/node"],
    "resources": {
      "../vendor/node-runtime/node_modules/npm/": "node-runtime/node_modules/npm/",
      "../plugin/dsh-desktop-shell/": "plugin/dsh-desktop-shell/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
